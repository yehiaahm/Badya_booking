# Badya Spaces — server settings. Copy this file to ".env" and fill it in.
# Lines starting with # are comments.

# ── Where students open the app (used for cookies and links) ──
# Must be https:// in production so sign-in cookies are protected.
PUBLIC_URL=https://spaces.badya.edu.eg

# Port the server listens on (put IIS, Nginx or Caddy with HTTPS in front of it).
PORT=3000
# Use 127.0.0.1 when the HTTPS reverse proxy runs on this same machine.
# HOST=127.0.0.1

# ── First administrator ──
# On first start this account becomes the super admin; everyone else is added from
# Settings → Team. Leave the password empty to have one generated and printed once in
# the server window. Change it after the first sign-in (account menu → Change password).
BOOTSTRAP_ADMIN_EMAIL=facilities@badya.edu.eg
BOOTSTRAP_ADMIN_NAME=Facilities Office
BOOTSTRAP_ADMIN_PASSWORD=

# ── Who can register ──
# Comma-separated. Can also be changed later in Settings → Security.
ALLOWED_EMAIL_DOMAINS=badya.edu.eg

# ── Optional ──
# Folder for the database, backups and generated secrets (default: ./data).
# DATA_DIR=D:\badya-spaces-data
# Days of daily backups to keep (default 14).
# BACKUP_KEEP_DAYS=14
# Campus time zone (default Africa/Cairo).
# TIMEZONE=Africa/Cairo
# Behind a reverse proxy the real client IP comes from X-Forwarded-For (default: on in production).
# TRUST_PROXY=true
# One-tap demo accounts are off on a production server even with demo data loaded.
# ALLOW_DEMO_SIGN_IN=false
# Secrets are generated automatically into DATA_DIR/secrets.json. Set them here only to
# share them between servers.
# SESSION_SECRET=
# QR_SECRET=
# Keys the national-ID fingerprints stored with the official student list. If it changes,
# load the student list again (Admin → Students) so registration checks keep working.
# ROSTER_SECRET=
